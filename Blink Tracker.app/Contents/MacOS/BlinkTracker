#!/bin/bash
set -e
RES="$(cd "$(dirname "$0")/../Resources" && pwd)"
SUPPORT="$HOME/Library/Application Support/BlinkTracker"
mkdir -p "$SUPPORT"
export BLINK_TRACKER_HOME="$SUPPORT"
export PATH="/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

# Build notification helper (AppleScript applet) on first launch if needed.
if [ -x "$RES/ensure-blink-notify.sh" ]; then
  "$RES/ensure-blink-notify.sh" "$RES" || true
fi
NOTIFY_HELPER="$RES/BlinkNotify.app/Contents/MacOS/applet"
if [ -x "$NOTIFY_HELPER" ]; then
  export BLINK_NOTIFY_HELPER="$NOTIFY_HELPER"
fi

# Prefer existing project venv, else create under Application Support
VENV="$SUPPORT/.venv"
if [ ! -x "$VENV/bin/python" ]; then
  # reuse ~/blink-tracker/.venv if present
  if [ -x "$HOME/blink-tracker/.venv/bin/python" ]; then
    VENV="$HOME/blink-tracker/.venv"
  else
    PY="$(command -v python3 || true)"
    if [ -z "$PY" ] && [ -x "$HOME/anaconda3/bin/python3" ]; then
      PY="$HOME/anaconda3/bin/python3"
    fi
    if [ -z "$PY" ]; then
      osascript -e 'display alert "Blink Tracker" message "Python 3 is required. Install Python 3, then open Blink Tracker again."'
      exit 1
    fi
    "$PY" -m venv "$SUPPORT/.venv"
    "$SUPPORT/.venv/bin/pip" install -U pip
    "$SUPPORT/.venv/bin/pip" install -r "$RES/requirements.txt"
    VENV="$SUPPORT/.venv"
  fi
fi

# migrate existing local db once
if [ ! -f "$SUPPORT/blinks.db" ] && [ -f "$HOME/blink-tracker/blinks.db" ]; then
  cp "$HOME/blink-tracker/blinks.db" "$SUPPORT/blinks.db" || true
fi
if [ ! -f "$SUPPORT/config.txt" ] && [ -f "$HOME/blink-tracker/config.txt" ]; then
  cp "$HOME/blink-tracker/config.txt" "$SUPPORT/config.txt" || true
fi

exec "$VENV/bin/python" "$RES/blink_tracker.py"
